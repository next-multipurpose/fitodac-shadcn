{
  "name": "@fitodac/shadcn",
  "description": "Libreria de componentes React y estilos Tailwind distribuida desde GitHub Packages.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fitodac-shadcn-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/app",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demos:registry": "node scripts/generate-demo-registry.mjs",
    "demos:registry:check": "node scripts/generate-demo-registry.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "init": "bash ./init.sh",
    "ai:doctor": "bash .ai/bin/doctor.sh",
    "ai:status": "node .ai/bin/status.mjs",
    "ai:runner": "bash .ai/bin/runner.sh",
    "ai:runner:interactive": "AI_RUNNER_INTERACTIVE=1 bash .ai/bin/runner.sh",
    "ai:runner:once": "AI_RUNNER_MAX_CYCLES=1 bash .ai/bin/runner.sh",
    "ai:dev:start": "bash .ai/bin/dev-server.sh start",
    "ai:dev:status": "bash .ai/bin/dev-server.sh status",
    "ai:dev:stop": "bash .ai/bin/dev-server.sh stop",
    "ai:playwright:install": "playwright install chromium",
    "ai:graphify:init": "bash .ai/bin/graphify.sh init",
    "ai:graphify:update": "bash .ai/bin/graphify.sh update",
    "ai:graphify:rebuild": "bash .ai/bin/graphify.sh rebuild",
    "ai:graphify:start": "bash .ai/bin/graphify.sh start",
    "ai:graphify:status": "bash .ai/bin/graphify.sh status",
    "ai:graphify:stop": "bash .ai/bin/graphify.sh stop",
    "ai:graphify:query": "bash .ai/bin/graphify.sh query",
    "ai:graphify:path": "bash .ai/bin/graphify.sh path",
    "ai:graphify:explain": "bash .ai/bin/graphify.sh explain",
    "ai:graphify:label": "bash .ai/bin/graphify.sh label"
  },
