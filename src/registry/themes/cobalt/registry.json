{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "cobalt",
      "type": "registry:theme",
      "title": "Cobalt",
      "description": "A cool, compact theme for Fitodac components with cobalt accents, blue-gray surfaces, restrained elevation, and balanced light/dark palettes.",
      "categories": ["theme", "blue", "enterprise"],
      "meta": {
        "version": "1.0.0",
        "designIntent": "Cool high-density application UI inspired by enterprise cloud interfaces without reproducing a specific design system."
      },
      "cssVars": {
        "theme": {
          "font-sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace",
          "radius-sm": "max(0px, calc(var(--radius) - 4px))",
          "radius-md": "max(0px, calc(var(--radius) - 2px))",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) + 4px)",
          "shadow-xs": "0 1px 1px rgb(15 23 42 / 0.04), 0 0 0 1px rgb(15 23 42 / 0.04)",
          "shadow-sm": "0 1px 2px rgb(15 23 42 / 0.06), 0 2px 4px -2px rgb(15 23 42 / 0.06)",
          "shadow-md": "0 6px 16px -4px rgb(15 23 42 / 0.12), 0 2px 6px rgb(15 23 42 / 0.05)",
          "shadow-lg": "0 16px 32px -8px rgb(15 23 42 / 0.16), 0 6px 12px rgb(15 23 42 / 0.07)",
          "shadow-xl": "0 24px 48px -12px rgb(15 23 42 / 0.20), 0 10px 20px rgb(15 23 42 / 0.08)"
        },
        "light": {
          "radius": "0.5rem",
          "background": "#f7f9fc",
          "foreground": "#111827",
          "card": "#ffffff",
          "card-foreground": "#111827",
          "popover": "#ffffff",
          "popover-foreground": "#111827",
          "primary": "#315efb",
          "primary-foreground": "#ffffff",
          "secondary": "#eef2f7",
          "secondary-foreground": "#253047",
          "muted": "#f1f4f8",
          "muted-foreground": "#667085",
          "accent": "#e9efff",
          "accent-foreground": "#2747b8",
          "destructive": "#d94b4b",
          "destructive-foreground": "#ffffff",
          "border": "#dfe4ec",
          "input": "#d5dce6",
          "ring": "#6c86ff",
          "chart-1": "#315efb",
          "chart-2": "#2d9a72",
          "chart-3": "#c88719",
          "chart-4": "#d95c59",
          "chart-5": "#66758a",
          "sidebar": "#f1f4f8",
          "sidebar-foreground": "#253047",
          "sidebar-primary": "#315efb",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "#e4eaf5",
          "sidebar-accent-foreground": "#20335f",
          "sidebar-border": "#d9e0ea",
          "sidebar-ring": "#6c86ff",
          "success": "#2d9a72",
          "success-foreground": "#ffffff",
          "warning": "#c88719",
          "warning-foreground": "#ffffff",
          "info": "#315efb",
          "info-foreground": "#ffffff"
        },
        "dark": {
          "radius": "0.5rem",
          "background": "#0b111b",
          "foreground": "#f3f6fb",
          "card": "#121a25",
          "card-foreground": "#f3f6fb",
          "popover": "#182230",
          "popover-foreground": "#f3f6fb",
          "primary": "#7591ff",
          "primary-foreground": "#0b1220",
          "secondary": "#202a37",
          "secondary-foreground": "#e6ebf3",
          "muted": "#18212d",
          "muted-foreground": "#9aa6b5",
          "accent": "#1f315f",
          "accent-foreground": "#d7e0ff",
          "destructive": "#ff726d",
          "destructive-foreground": "#2b0c0c",
          "border": "#2a3645",
          "input": "#364455",
          "ring": "#8ca2ff",
          "chart-1": "#7591ff",
          "chart-2": "#64c69d",
          "chart-3": "#e6b45a",
          "chart-4": "#ff7d78",
          "chart-5": "#94a3b8",
          "sidebar": "#0f1723",
          "sidebar-foreground": "#e6edf7",
          "sidebar-primary": "#7591ff",
          "sidebar-primary-foreground": "#0b1220",
          "sidebar-accent": "#1a2636",
          "sidebar-accent-foreground": "#dbe5f3",
          "sidebar-border": "#263242",
          "sidebar-ring": "#8ca2ff",
          "success": "#64c69d",
          "success-foreground": "#071b13",
          "warning": "#e6b45a",
          "warning-foreground": "#231803",
          "info": "#7591ff",
          "info-foreground": "#0b1220"
        }
      }
    }
  ]
}
